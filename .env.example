APP_ENV=production
APP_URL=https://example.com
APP_NAME="Magic Link"
APP_LOCALE=de

# sqlite is the zero-setup default. The path is relative to the repository root.
DB_DRIVER=sqlite
DB_PATH=storage/database.sqlite

# MySQL alternative:
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=magic_link
# DB_USERNAME=magic_link
# DB_PASSWORD=change-me

# mail uses PHP's configured mail transport. smtp works on shared hosting/VPS.
# log is development-only and writes messages to storage/mail/.
MAIL_TRANSPORT=mail
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Magic Link"
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_ENCRYPTION=tls
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Fail closed by default: configure at least one allowed email or domain.
MAGICLINK_ALLOWED_EMAILS=owner@example.com
MAGICLINK_ALLOWED_DOMAINS=
MAGICLINK_ALLOW_ANY_EMAIL=false
MAGICLINK_TTL_SECONDS=900
MAGICLINK_IP_LIMIT=10
MAGICLINK_EMAIL_LIMIT=5
MAGICLINK_RATE_WINDOW=3600

SESSION_NAME=magiclink_session
