APP_ENV=production
APP_URL=https://example.com
APP_NAME="Magic Link"
APP_LOCALE=de
# Optional absolute destination after a successful email-link exchange.
AUTH_SUCCESS_URL=

# Optional confidential-backend authorization-code handoff. Generate the secret with:
# php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# HANDOFF_REDIRECT_URL=https://app.example.com/auth/magic-link
# HANDOFF_CLIENT_SECRET=
# HANDOFF_TRANSACTION_TTL_SECONDS=900
# HANDOFF_CODE_TTL_SECONDS=60
# HANDOFF_INIT_LIMIT=1000
# HANDOFF_INIT_WINDOW=600

# sqlite is the zero-setup default. The path is relative to the repository root.
DB_DRIVER=sqlite
DB_PATH=storage/database.sqlite

# MySQL alternative:
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=magic_link
# DB_USERNAME=magic_link
# DB_PASSWORD=change-me
# auto uses verified TLS when a CA is present and fails closed for remote
# production MySQL. Remote production always requires hostname verification.
# DB_SSL_MODE=verify_identity
# DB_SSL_CA=storage/mysql-ca.pem

# mail uses PHP's configured mail transport. smtp works on shared hosting/VPS.
# log is development-only and writes messages to storage/mail/.
MAIL_TRANSPORT=mail
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Magic Link"
# Optional relative path inside this installation. Copy resources/mail-templates
# before editing so upgrades do not overwrite your mail design.
# MAIL_TEMPLATE_DIR=storage/mail-templates
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_ENCRYPTION=tls
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Fail closed by default: configure at least one allowed email or domain.
MAGICLINK_ALLOWED_EMAILS=owner@example.com
MAGICLINK_ALLOWED_DOMAINS=
MAGICLINK_ALLOW_ANY_EMAIL=false
MAGICLINK_TTL_SECONDS=900
MAGICLINK_IP_LIMIT=10
MAGICLINK_EMAIL_LIMIT=5
MAGICLINK_GLOBAL_LIMIT=1000
MAGICLINK_RATE_WINDOW=3600
MAGICLINK_EXCHANGE_IP_LIMIT=60
MAGICLINK_EXCHANGE_SELECTOR_LIMIT=10
MAGICLINK_EXCHANGE_GLOBAL_LIMIT=1000
MAGICLINK_EXCHANGE_WINDOW=900

# auto chooses safe SQLite/MySQL defaults. Explicit values remain under your control.
MAGICLINK_STATE_BATCH_MAX=auto
MAGICLINK_POLL_AFTER_MS=2500

# The request is answered before mail delivery. Keep true for zero-setup hosting;
# turn it off when bin/worker.php runs through cron or a service.
MAIL_AUTO_DISPATCH=true
MAIL_WORKER_BATCH=auto
MAIL_PENDING_MAX=auto
MAIL_MAX_ATTEMPTS=5
MAIL_LOCK_TIMEOUT_SECONDS=300

# Bounded retention and cleanup.
MAGICLINK_RETENTION_SECONDS=604800
MAIL_RETENTION_SECONDS=604800
AUDIT_RETENTION_SECONDS=2592000
HANDOFF_RETENTION_SECONDS=86400
MAINTENANCE_BATCH=auto
MAINTENANCE_INTERVAL_SECONDS=300

HTTP_MAX_BODY_BYTES=16384

# Comma-separated exact origins for a separate headless UI.
API_ALLOWED_ORIGINS=
# Only list reverse proxies you actually operate, e.g. 10.0.0.0/8.
TRUSTED_PROXIES=

SESSION_NAME=magiclink_session
# files is zero-setup. configured keeps the PHP/host-level handler (for example
# Redis) and is the multi-node option when requests are not sticky.
SESSION_STORAGE=files
SESSION_SAVE_PATH=storage/sessions
SESSION_SAMESITE=Lax
SESSION_IDLE_SECONDS=28800
SESSION_ABSOLUTE_SECONDS=604800
